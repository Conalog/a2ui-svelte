{
  "name": "@conalog/a2ui-svelte-explorer",
  "private": true,
  "version": "0.1.0",
  "description": "A2UI Svelte Explorer",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "node build",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "yarn typecheck && yarn test:e2e",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --ignore-path ../../../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../../../.prettierignore --check ."
  },
  "dependencies": {
    "@a2ui/markdown-it": "^0.2.4",
    "@a2ui/web_core": "^0.16.1",
    "@conalog/a2ui-svelte": "workspace:^",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.58.1",
    "@sveltejs/adapter-node": "^6.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@types/node": "^22.0.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
